<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <DataTemplate.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded"
                    Value="False" />
            <Setter Property="Margin"
                    Value="0,1,0,1" />
            <Setter Property="Padding"
                    Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}"
                             Value="True">
                    <Setter Property="IsExpanded"
                            Value="True" />
                </DataTrigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#264F78" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
                                BorderThickness="1,1,1,0"
                                Padding="10,4"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                                              TextElement.FontFamily="Consolas"
                                              TextElement.FontSize="11" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}" />
                            <Border Grid.Row="1"
                                    Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
                                    BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </DataTemplate.Resources>

    <Grid Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="2.8*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,4">
            <Button Content="Expand All"
                    Command="{Binding ExpandAllCommand}"
                    FontFamily="Consolas"
                    FontSize="11"
                    Padding="8,3"
                    Margin="0,0,4,0"
                    Background="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}"
                    Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
                    BorderThickness="1" />
            <Button Content="Collapse All"
                    Command="{Binding CollapseAllCommand}"
                    FontFamily="Consolas"
                    FontSize="11"
                    Padding="8,3"
                    Background="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}"
                    Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
                    BorderThickness="1" />
        </StackPanel>

        <!-- Tree -->
        <TreeView x:Name="NodeTree"
                  Grid.Row="1"
                  Grid.Column="0"
                  ItemsSource="{Binding Roots}"
                  BorderThickness="1"
                  Padding="4"
                  Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                  BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
                  Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Border x:Name="NodeCard"
                            CornerRadius="3"
                            Padding="6,3,8,3"
                            Margin="1,2"
                            BorderThickness="2,0,0,0"
                            BorderBrush="#808080"
                            Background="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}">
                        <Border.ToolTip>
                            <StackPanel MaxWidth="400">
                                <TextBlock Text="{Binding Path}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Opacity="0.6" />
                                <TextBlock Text="{Binding NodeType}"
                                           FontFamily="Consolas"
                                           FontSize="11" />
                                <TextBlock Text="{Binding TypeDisplay}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#569CD6" />
                            </StackPanel>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="BadgeBorder"
                                    Background="#3F3F46"
                                    CornerRadius="2"
                                    Padding="4,1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Badge"
                                           Text="?"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#808080"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Display}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                            <TextBlock Text="  " />
                            <TextBlock Text="{Binding TypeDisplay}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                        </StackPanel>
                    </Border>

                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Lambda">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#C586C0" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="LAMBDA" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#C586C0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Binary">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#D4D4AA" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="BINARY" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#D4D4AA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Constant">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#B5CEA8" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="CONST" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#B5CEA8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="MethodCall">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#DCDCAA" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="CALL" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#DCDCAA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Member">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#9CDCFE" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="MEMBER" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#9CDCFE" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Parameter">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#569CD6" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="PARAM" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#569CD6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Unary">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#CE9178" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="UNARY" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#CE9178" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="MemberInit">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#4EC9B0" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="INIT" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#4EC9B0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Binding">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#4EC9B0" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="BIND" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#4EC9B0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Conditional">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#D7BA7D" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="COND" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#D7BA7D" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="New">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#4EC9B0" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="NEW" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#4EC9B0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="TypeBinary">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#CE9178" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="TYPE" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#CE9178" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Invocation">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#DCDCAA" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="INVOKE" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#DCDCAA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="NewArray">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#B8D7A3" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="ARRAY" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#B8D7A3" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="ListInit">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#B8D7A3" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="LIST" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#B8D7A3" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="ElementInit">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#B8D7A3" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="ELEM" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#B8D7A3" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Index">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#9CDCFE" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="INDEX" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#9CDCFE" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Default">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#808080" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="DEFAULT" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#808080" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Block">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#C586C0" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="BLOCK" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#C586C0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Try">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#D16969" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="TRY" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#D16969" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="CatchBlock">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#D16969" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="CATCH" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#D16969" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Switch">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#D7BA7D" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="SWITCH" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#D7BA7D" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="SwitchCase">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#D7BA7D" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="CASE" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#D7BA7D" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Goto">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#D16969" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="GOTO" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#D16969" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Label">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#569CD6" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="LABEL" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#569CD6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Loop">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#C586C0" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="LOOP" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#C586C0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}"
                                     Value="Unsupported">
                            <Setter TargetName="NodeCard"
                                    Property="BorderBrush"
                                    Value="#808080" />
                            <Setter TargetName="Badge"
                                    Property="Text"
                                    Value="?" />
                            <Setter TargetName="Badge"
                                    Property="Foreground"
                                    Value="#808080" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Width="6"
                      Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}" />

        <!-- Detail / End nodes tabs -->
        <TabControl Grid.Row="1"
                    Grid.Column="2"
                    Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                    Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
                    FontFamily="Consolas"
                    FontSize="12">

            <!-- Tab 1: Details -->
            <TabItem Header="Details">
                <Border DataContext="{Binding SelectedItem, ElementName=NodeTree}"
                        Padding="12"
                        Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                        TextElement.Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,0,0,10">
                            <TextBlock Text="{Binding Display}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">
                                <Border Background="#3F3F46"
                                        CornerRadius="3"
                                        Padding="6,2">
                                    <TextBlock Text="{Binding Kind}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#9CDCFE" />
                                </Border>
                                <TextBlock Text="  " />
                                <TextBlock Text="{Binding NodeType}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Opacity="0.6"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TypeDisplay}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#569CD6"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top"
                                Height="1"
                                Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
                                Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#9CDCFE" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Tab 2: End nodes -->
            <TabItem Header="End Nodes">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                              Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}">
                    <StackPanel Margin="12">

                        <!-- Parameters -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasParameterEndNodes}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="#3F3F46"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Parameters"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#569CD6" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding ParameterEndNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,3"
                                                Margin="0,1"
                                                CornerRadius="2"
                                                Background="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                                                <TextBlock Text="  "
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#569CD6"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Constants -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConstantEndNodes}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="#3F3F46"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Constants"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#B5CEA8" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding ConstantEndNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,3"
                                                Margin="0,1"
                                                CornerRadius="2"
                                                Background="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                                                <TextBlock Text="  "
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#569CD6"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="  = "
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Opacity="0.5"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Value}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="#B5CEA8"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Closed-vver variables -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasClosedOverEndNodes}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="#3F3F46"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Closed-Over Variables"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#9CDCFE" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding ClosedOverEndNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,3"
                                                Margin="0,1"
                                                CornerRadius="2"
                                                Background="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                                                <TextBlock Text="  "
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#569CD6"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Defaults -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDefaultEndNodes}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Background="#3F3F46"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Defaults"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#808080" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding DefaultEndNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,3"
                                                Margin="0,1"
                                                CornerRadius="2"
                                                Background="{DynamicResource {x:Static styles:VsBrushes.CommandBarMenuBackgroundGradientBeginKey}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                                                <TextBlock Text="  "
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding TypeDisplay}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#569CD6"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Readable expression (code view) -->
        <Border Grid.Row="3"
                Grid.ColumnSpan="3"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4"
                Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="Source Code"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.6"
                           Margin="8,4,0,2"
                           Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                <TextBox Text="{Binding ReadableText}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="0"
                         Padding="8"
                         Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
                         Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
            </DockPanel>
        </Border>
    </Grid>
</DataTemplate>